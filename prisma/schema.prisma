datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// --- ENUMS DAARA.NET ---
enum Role {
  SUPER_ADMIN
  SERIGNE_DAARA
  OUSTAZ
  NDEYI_DAARA
  PARENT
  GESTIONNAIRE
}

enum DaaraPlan {
  STARTER
  GROWTH
  BUSINESS
}

enum DaaraType {
  TRADITIONNEL
  MODERNE
  FRANCO_ARABE
}

enum TalibeStatus {
  INTERNE     // Pensionnaire à temps plein dans le Daara
  EXTERNE     // Apprenant venant pour les cours du matin/soir
}

enum HifzEvaluation {
  MUMTAZ        // Excellent (ممتاز)
  JAYYID_JIDDAN // Très Bien (جيد جداً)
  JAYYID        // Bien (جيد)
  A_REVISER     // À Réviser (يحتاج مراجعة)
}

enum HifzCategory {
  SABI            // Nouveau verset / leçon du jour sur l'Allwa (لوح)
  MURAJAA_QARIBA  // Révision récente (derniers Hizb)
  MURAJAA_BAIDA   // Révision générale (Tillawa)
}

enum AttendanceSession {
  HALQA_FAJR     // Séance après la prière du Subh
  HALQA_MORNING  // Séance du matin
  HALQA_AFTERNOON// Séance de l'après-midi
  HALQA_EVENING  // Séance de la nuit / Isha
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  RETARD
  EXCUSED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

enum DonationType {
  FINANCIER   // Don d'argent (Wave, OM, Cash)
  DON_NATURE  // Sacs de riz, huile, vêtements, nattes, savon
}

enum TransactionType {
  INCOME
  EXPENSE
}

// --- STRUCTURE DAARA.NET (ÉTABLISSEMENT CORANIQUE) ---
model Daara {
  id          String     @id @default(cuid())
  name        String     // Nom du Daara (ex: Daara Serigne Touba, Daara Coki, Daara El-Hadj Malick)
  type        DaaraType  @default(TRADITIONNEL)
  address     String?
  city        String?    // Ex: Dakar, Touba, Tivaouane, Saint-Louis, Kaolack, Kolda
  country     String     @default("Sénégal")
  phone       String?
  email       String?
  logo        String?    // URL du logo du Daara pour les attestations & reçus
  ninea       String?    // Numéro d'enregistrement ou agrément officiel
  plan        DaaraPlan  @default(STARTER)
  config      Json?      // Paramètres personnalisés (Intitlé des parrainages, lecture Warsh/Hafs, etc.)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  ownerId     String?
  owner       User?      @relation("DaaraOwner", fields: [ownerId], references: [id])
  
  users        User[]
  halqas       Halqa[]
  talibes      Talibe[]
  hifzRecords  HifzProgress[]
  sponsorships Sponsorship[]
  donations    Donation[]
  khatmRecords KhatmRecord[]
  attendances  Attendance[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  notifications Notification[]
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  phone              String?
  emailVerified      DateTime?
  image              String?
  password           String?
  role               Role               @default(SERIGNE_DAARA)
  plan               DaaraPlan          @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  hasSeenOnboarding  Boolean            @default(false)
  daaraId            String?
  daara              Daara?             @relation(fields: [daaraId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  accounts           Account[]
  sessions           Session[]
  payments           Payment[]
  ownedDaaras        Daara[]            @relation("DaaraOwner")
  sponsorships       Sponsorship[]      @relation("NdeyiDaaraSponsorships")
  givenDonations     Donation[]         @relation("UserDonations")
  hifzTaught         HifzProgress[]     @relation("OustazHifz")
  auditLogs          AuditLog[]
  notifications      Notification[]     @relation("UserNotifications")
}

// Model de paiement d'abonnement SaaS (PayTech / PayDunya / Wave)
model Payment {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  amount      Float
  plan        DaaraPlan
  status      String     // SUCCESS, PENDING, FAILED
  provider    String     // PayTech, Wave, Orange Money
  providerRef String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// NextAuth Models (Auth.js v5)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- HALQAS (CERCLES D'ÉTUDes CORANIQUES) ---
model Halqa {
  id          String   @id @default(cuid())
  daaraId     String
  daara       Daara    @relation(fields: [daaraId], references: [id])
  name        String   // Ex: "Halqa Juz Amma", "Halqa Al-Baqara", "Halqa Warsh"
  level       String?  // Ex: "DÉBUTANT (Mouqadima)", "MÉMORISATION (Hifz)", "PERFECTIONNEMENT (Tajwid)"
  oustazName  String?  // Nom du maître coranique référent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  talibes Talibe[]

  @@index([daaraId])
}

// --- TALIBÉS (APPRENANTS CORANIQUES) ---
model Talibe {
  id          String       @id @default(cuid())
  daaraId     String
  daara       Daara        @relation(fields: [daaraId], references: [id])
  halqaId     String?
  halqa       Halqa?       @relation(fields: [halqaId], references: [id])
  matricule   String       // Numéro matricule unique (Ex: DAA-2026-0042)
  firstName   String
  lastName    String
  gender      String       @default("M") // M / F
  dateOfBirth DateTime?
  photo       String?
  status      TalibeStatus @default(INTERNE) // Pensionnaire Interne ou Externe
  healthNotes String?      // Allergies, traitements, suivi médical du Talibé

  parentName  String?      // Père / Mère / Tuteur légal
  parentPhone String?      // Numéro WhatsApp pour alertes mémorisation et santé
  parentEmail String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  hifzRecords  HifzProgress[]
  sponsorships Sponsorship[]
  khatmRecords KhatmRecord[]
  attendances  Attendance[]

  @@unique([daaraId, matricule])
  @@index([daaraId, halqaId])
}

// --- SUIVI DE MÉMORISATION DU SAINT CORAN (HIFZ, MURAJAA & ALLWA) ---
model HifzProgress {
  id          String         @id @default(cuid())
  daaraId     String
  daara       Daara          @relation(fields: [daaraId], references: [id])
  talibeId    String
  talibe      Talibe         @relation(fields: [talibeId], references: [id])
  oustazId    String?
  oustaz      User?          @relation("OustazHifz", fields: [oustazId], references: [id])
  
  date        DateTime       @default(now())
  hizbNumber  Int            // Numéro du Hizb (1 à 60)
  juzNumber   Int?           // Numéro du Juz (1 à 30)
  surahName   String?        // Nom de la Sourate (Ex: Al-Baqara, Al-Kahf, Yasin)
  surahNumber Int?           // Numéro de la Sourate (1 à 114)
  ayahStart   Int?           // Verset de début
  ayahEnd     Int?           // Verset de fin
  
  category    HifzCategory   @default(SABI)
  evaluation  HifzEvaluation @default(JAYYID)
  allwaNotes  String?        // Remarques sur l'écriture sur la planche en bois (Allwa / لوح)
  comments    String?        // Appréciation de l'Oustaz

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([daaraId, talibeId])
  @@index([daaraId, date])
}

// --- PARRAINAGE TAKAFUL & NDEYI DAARA ---
model Sponsorship {
  id          String    @id @default(cuid())
  daaraId     String
  daara       Daara     @relation(fields: [daaraId], references: [id])
  talibeId    String
  talibe      Talibe    @relation(fields: [talibeId], references: [id])
  sponsorId   String?
  sponsor     User?     @relation("NdeyiDaaraSponsorships", fields: [sponsorId], references: [id])
  
  sponsorName String    // Nom de la Ndeyi Daara ou du Parrain
  sponsorPhone String   // Téléphone WhatsApp
  monthlyAmount Float   // Montant du parrainage mensuel (ex: 15 000 FCFA)
  status      String    @default("ACTIVE") // ACTIVE, PAUSED, ENDED
  startDate   DateTime  @default(now())
  notes       String?   // Ex: "Prise en charge de l'alimentation et vêtements"

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([daaraId, talibeId])
}

// --- DONS & SADAQA (FINANCIER ET DONS EN NATURE) ---
model Donation {
  id            String       @id @default(cuid())
  daaraId       String
  daara         Daara        @relation(fields: [daaraId], references: [id])
  donorId       String?
  donor         User?        @relation("UserDonations", fields: [donorId], references: [id])
  
  donorName     String       // Nom du donateur ou anonyme
  donorPhone    String?
  type          DonationType @default(FINANCIER)
  amount        Float?       // Montant si financier (FCFA, EUR, USD)
  natureDetails String?      // Ex: "10 sacs de riz de 50kg, 2 bidons d'huile 20L"
  paymentMethod String?      // Wave, Orange Money, Cash, Virement
  receiptNumber String?      // Numéro de reçu généré (REC-SADAQA-001)
  notes         String?      // Zakat Al-Mal, Tabaski, Korité, Magal
  date          DateTime     @default(now())

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([daaraId, date])
}

// --- KHATM AL-QURAN & IJAZAH (MEMORISATION INTEGRALE COMPLÈTE) ---
model KhatmRecord {
  id             String    @id @default(cuid())
  daaraId        String
  daara          Daara     @relation(fields: [daaraId], references: [id])
  talibeId       String
  talibe         Talibe    @relation(fields: [talibeId], references: [id])
  
  completionDate DateTime  @default(now())
  qiraatVersion  String    @default("Warsh 'an Nafi'") // Warsh, Hafs, etc.
  oustazName     String    // Maître ayant certifié le Khatm
  certificateUrl String?   // URL du diplôme d'Ijazah PDF généré
  notes          String?

  createdAt      DateTime  @default(now())

  @@index([daaraId, talibeId])
}

// --- PRÉSENCE & ASSIDUITÉ DES TALIBÉS ---
model Attendance {
  id             String            @id @default(cuid())
  daaraId        String
  daara          Daara             @relation(fields: [daaraId], references: [id])
  talibeId       String
  talibe         Talibe            @relation(fields: [talibeId], references: [id])
  date           DateTime          @default(now())
  session        AttendanceSession @default(HALQA_MORNING)
  status         AttendanceStatus  @default(PRESENT)
  reason         String?
  parentNotified Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([daaraId, date])
}

// --- COMPTABILITÉ & TRÉSORERIE DAARA ---
model Transaction {
  id          String          @id @default(cuid())
  daaraId     String
  daara       Daara           @relation(fields: [daaraId], references: [id])
  amount      Float
  type        TransactionType
  category    String          // Ex: "SADAQA", "PARRAINAGE", "NOURRITURE", "SANTE", "REPARATION"
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([daaraId, createdAt])
}

// --- AUDIT LOGS & NOTIFICATIONS ---
model AuditLog {
  id        String   @id @default(cuid())
  daaraId   String
  daara     Daara    @relation(fields: [daaraId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // Ex: "RECORDED_HIFZ", "ADDED_SADAQA", "CREATED_TALIBE"
  details   Json?
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserNotifications", fields: [userId], references: [id])
  daaraId     String?
  daara       Daara?   @relation(fields: [daaraId], references: [id])
  title       String
  description String
  type        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
